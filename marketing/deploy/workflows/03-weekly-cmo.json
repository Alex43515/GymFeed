    {
      "parameters": {
        "jsCode": "const timezone = 'America/New_York';\nconst localNow = $now.setZone(timezone);\nconst daysUntilMonday = ((8 - localNow.weekday) % 7) || 7;\nconst startDate = localNow.plus({ days: daysUntilMonday }).toFormat('yyyy-MM-dd');\nconst name = `GymFeed weekly ideas ${startDate}`;\nreturn [{ json: { action: 'plan_campaign', name, startDate, days: 7, timezone, requestKey: `campaign:${name}:${startDate}:7:${timezone}` } }];"
      },
      "id": "99685fcf-a0f3-4f59-8b72-adc85958a4d2",
