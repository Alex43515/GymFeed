    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nif (!Array.isArray(response.actions)) throw new Error('CMO decision endpoint must return an actions array');\nreturn response.actions.map((item) => {\n  if (!['idea_decision', 'asset_decision'].includes(item.action) || !item.entry) {\n    throw new Error('Dispatcher accepts only explicit idea_decision or asset_decision entries');\n  }\n  return { json: { action: item.action, entry: item.entry } };\n});"
      },
